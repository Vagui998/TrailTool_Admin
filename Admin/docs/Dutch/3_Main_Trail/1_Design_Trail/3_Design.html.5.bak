ghlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 30.225px; font-family: WordVisiCarriageReturn_MSFontService, Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span class="SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; text-wrap-mode: nowrap !important;">&nbsp;</span><br class="SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; text-wrap-mode: nowrap !important;"></span></span><span class="TrackedChange SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">In een </span></span><span class="TrackedChange SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW121068217 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">transdisciplinaire</span></span><s