nt-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; font-style: italic; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:360}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;

</span></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="261090100" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{49}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; font-style: italic; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">Diversiteit in belang</span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:360}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="1206471213" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{56}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span class="NormalTextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;">Als teamlid doe je om verschillende redenen mee aan een transdisciplinair project. Denk aan persoonlijke, financiële of </span><span class="NormalTextRun SpellingErrorV2Themed SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; background-position: 0px 100%; background-repeat: repeat-x; background-image: url(&quot;data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1IiBoZWlnaHQ9IjQiPjxnIGZpbGw9Im5vbmUiIGZpbGwtcnVsZT0iZXZlbm9kZCI+PHBhdGggc3Ryb2tlPSIjRUIwMDAwIiBkPSJNMCAzYzEuMjUgMCAxLjI1LTIgMi41LTJTMy43NSAzIDUgMyIvPjxwYXRoIGQ9Ik0wIDBoNXY0SDB6Ii8+PC9nPjwvc3ZnPg==&quot;); border-bottom: 1px solid transparent;">werkgerelateerde</span><span class="NormalTextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;"> redenen. Stel jezelf de vraag: wie heeft welke belangen en waarom? Wees eerlijk hierin. Deze zijn namelijk niet altijd zichtbaar. Wanneer je het niet uitspreekt, kun je het proces erg complex en frustrerend maken. Spreek je dus uit en help conflicten constructief op te lossen. En draag bij aan betere en creatievere oplossingen.</span></span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:360}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;

</span></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="1325293025" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{63}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; font-style: italic; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">Diversiteit in macht</span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:360}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="1648191046" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{70}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">In een transdisciplinaire samenwerking heb je bijna altijd te maken met ongelijke machtsverhoudingen. Iemands functie, netwerk, kennis of persoonlijkheid bepaalt onder meer de macht. Als je deze machtsverhoudingen niet meeneemt of uitspreekt, kan dit leiden tot frustratie. Maar je kunt macht ook gebruiken (Oskam, 2023). Samen dromen over de toekomst en jullie gezamenlijke doel is daarin een eerste stap. Praat over dat je met het behalen van het gezamenlijke doel de positie van alle partijen verandert: je creëert een nieuw speelveld. Het betekent dat machtige spelers dingen moeten opgeven en veranderen. Want het gezamenlijk doel staat boven alles.</span></p><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="1648191046" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{70}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><br></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="821711839" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{77}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; font-style: italic; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">Diversiteit in kennis</span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:360}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 39px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></p></div><div class="OutlineElement Ltr SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; clear: both; cursor: text; overflow: visible; position: relative; direction: ltr; color: rgb(0, 0, 0); font-family: &quot;Segoe UI&quot;, &quot;Segoe UI Web&quot;, Arial, Verdana, sans-serif; font-size: 12px;"><p class="Paragraph TrackedChange SCXW105734617 BCX8" paraid="473181948" paraeid="{5d14ff14-5c54-4162-a8ea-ee5235011159}{84}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin-right: 0px; margin-bottom: 10.6667px; margin-left: 0px; padding: 0px; user-select: text; overflow-wrap: break-word; white-space-collapse: preserve; vertical-align: baseline; font-kerning: none; background-color: transparent; color: windowtext;"><span data-contrast="none" xml:lang="NL-NL" lang="NL-NL" class="TextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-variant-position: normal; font-variant-emoji: normal; font-size: 16pt; line-height: 30.1167px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span class="NormalTextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;">De verschillende soorten kennis van alle teamleden is de basis van je project</span><span class="NormalTextRun ContextualSpellingAndGrammarErrorV2Themed SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; background-position: 0px 100%; background-repeat: repeat-x; background-image: url(&quot;data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1IiBoZWlnaHQ9IjMiPjxnIGZpbGw9Im5vbmUiIGZpbGwtcnVsZT0iZXZlbm9kZCIgc3Ryb2tlPSIjMzVGIiBzdHJva2UtbGluZWNhcD0icm91bmQiPjxwYXRoIGQ9Ik0wIC41aDVNMCAyLjVoNSIvPjwvZz48L3N2Zz4=&quot;); border-bottom: 1px solid transparent;">. ,</span><span class="NormalTextRun SCXW105734617 BCX8" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text;"> met een mix van wetenschappelijke en praktische inzichten die bijdragen aan systeemkennis (het begrijpen van de huidige realiteit), doelkennis (het visualiseren van het gewenste resultaat) en transformatiekennis (het overgaan van systeemkennis naar doelkennis) (Oskam, 2023). Deelnemers brengen verschillende soorten kennis mee, uit hun ervaringen of levensstijlen. Maak inzichtelijk wat ieders kennis, expertise en ervaring is en welke soort kennis iemand kan en wil inbrengen.</span></span><span class="EOP SCXW105734617 BCX8" data-ccp-props="{&quot;201341983&quot;:0,&quot;335559740&quot;:278}" style="-webkit-user-drag: none; -webkit-tap-highlight-color: transparent; margin: 0px; padding: 0px; user-select: text; font-size: 16pt; line-height: 30.1167px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></p></div></body>
</html>