<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transdisciplinary Education</title>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            color: #333;
            line-height: 1.6;
            margin: 20px;
            padding: 0;
        }

        h1 {
            font-weight: 700;
            font-size: 32px;
            margin-bottom: 16px;
        }

        h2 {
            font-weight: 600;
            font-size: 24px;
            margin-bottom: 12px;
        }

        p {
            margin-bottom: 16px;
            font-size: 18px;
            font-weight: 400;
        }

        ul {
            margin-bottom: 16px;
            padding-left: 20px;
            font-size: 18px;
            font-weight: 400;
        }

        img {
            width: 90%;
            display: block;
            margin: 0 auto;
        }
    </style>
</head>

