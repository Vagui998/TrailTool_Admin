<html><head><title>Collaboration Culture</title>
<meta http-equiv="content-type" content="text/html; charset=UTF-8"></head><body><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px;">To</span><span style="margin: 0px;"> </span><span style="margin: 0px;">create</span><span style="margin: 0px;"> a strong </span><span style="margin: 0px;">collaboration</span><span style="margin: 0px;"> culture, </span><span style="margin: 0px;">there</span><span style="margin: 0px;"> are </span><span style="margin: 0px;">several</span><span style="margin: 0px;"> </span><span style="margin: 0px;">general</span><span style="margin: 0px;"> </span><span style="margin: 0px;">conditions</span><span style="margin: 0px;"> </span><span style="margin: 0px;">that</span><span style="margin: 0px;"> help support </span><span style="margin: 0px;">the</span><span style="margin: 0px;"> </span><span style="margin: 0px;">process</span><span style="margin: 0px;">. </span><span style="margin: 0px;">Since</span><span style="margin: 0px;"> </span><span style="margin: 0px;">transdisciplinary</span><span style="margin: 0px;"> </span><span style="margin: 0px;">work</span><span style="margin: 0px;"> </span><span style="margin: 0px;">differs</span><span style="margin: 0px;"> in </span><span style="margin: 0px;">complexity</span><span style="margin: 0px;"> </span><span style="margin: 0px;">and</span><span style="margin: 0px;"> </span><span style="margin: 0px;">expectations</span><span style="margin: 0px;"> </span><span style="margin: 0px;">from</span><span style="margin: 0px;"> </span><span style="margin: 0px;">the</span><span style="margin: 0px;"> types of </span><span style="margin: 0px;">collaboration</span><span style="margin: 0px;"> most </span><span style="margin: 0px;">people</span><span style="margin: 0px;"> are </span><span style="margin: 0px;">familiar</span><span style="margin: 0px;"> </span><span style="margin: 0px;">with</span><span style="margin: 0px;">, </span><span style="margin: 0px;">it’s</span><span style="margin: 0px;"> important </span><span style="margin: 0px;">to</span><span style="margin: 0px;"> </span><span style="margin: 0px;">become</span><span style="margin: 0px;"> </span><span style="margin: 0px;">acquainted</span><span style="margin: 0px;"> </span><span style="margin: 0px;">with</span><span style="margin: 0px;"> </span><span style="margin: 0px;">it</span><span style="margin: 0px;"> beforehand.</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></font></p></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px">On </span><span style="margin: 0px">the</span><span style="margin: 0px"> </span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif; font-weight: bold"><span style="margin: 0px">Theory</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px"> page, five </span><span style="margin: 0px">conditions</span><span style="margin: 0px"> are </span><span style="margin: 0px">discussed</span><span style="margin: 0px"> </span><span style="margin: 0px">that</span><span style="margin: 0px"> support a culture in </span><span style="margin: 0px">which</span><span style="margin: 0px"> </span><span style="margin: 0px">transdisciplinary</span><s