<body><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">The</span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">  </span><a href="https://www.kcrutrecht.nl/producten/participatiematrix/" target="_blank" rel="noreferrer noopener" style="margin: 0px;"><span lang="NL-NL" style="margin: 0px; font-size: 16px; text-decoration-line: underline; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px">Participatiematrix</span></span></a><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px"> is a tool </span><span style="margin: 0px">for</span><span style="margin: 0px"> </span><span style="margin: 0px">discussing</span><span style="margin: 0px"> </span><span style="margin: 0px">each</span><span style="margin: 0px"> </span><span style="margin: 0px">person’s</span><span style="margin: 0px"> </span><span style="margin: 0px">desired</span><span style="margin: 0px"> </span><span style="margin: 0px">role</span><span style="margin: 0px"> in a (research) project. It was </span><span style="margin: 0px">originally</span><span style="margin: 0px"> </span><span style="margin: 0px">developed</span><span style="margin: 0px"> </span><span style="margin: 0px">for</span><span style="margin: 0px"> </span><span style="margin: 0px">collaboration</span><span style="margin: 0px"> </span><span style="margin: 0px">with</span><span style="margin: 0px"> </span><span style="margin: 0px">patients</span><span style="margin: 0px"> (experts </span><span style="margin: 0px">by</span><span style="margin: 0px"> </span><span style="margin: 0px">experience</span><span style="margin: 0px">), but </span><span style="margin: 0px">it</span><span style="margin: 0px"> </span><span style="margin: 0px">can</span><span style="margin: 0px"> </span><span style="margin: 0px">be</span><span style="margin: 0px"> </span><span style="margin: 0px">applied</span><span style="margin: 0px"> more </span><span style="margin: 0px">broadly</span><span style="margin: 0px"> — </span><span style="margin: 0px">including</span><span style="margin: 0px"> in </span><span style="margin: 0px">your</span><span style="margin: 0px"> project.</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></font></p></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px">Here are a few </span><span style="margin: 0px">final</span><span style="margin: 0px"> practical tips </span><span style="margin: 0px">to</span><span style="margin: 0px"> help </span><span style="margin: 0px">you</span><span style="margin: 0px"> get </span><span style="margin: 0px">to</span><span style="margin: 0px"> </span><span style="margin: 0px">know</span><span style="margin: 0px"> </span><span style="margin: 0px">each</span><span style="margin: 0px"> </span><span style="margin: 0px">other</span><span style="margin: 0px"> </span><span style="margin: 0px">and</span><span style="margin: 0px"> </span><span style="margin: 0px">each</span><span style="margin: 0px"> </span><span style="margin: 0px">other’s</span><span style="margin: 0px"> </span><span style="margin: 0px">roles</span><span style="margin: 0px"> </span><span style="margin: 0px">better</span><span style="margin: 0px">:</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif">&nbsp;</span></font></p></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><ul role="list" style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px; font-family: verdana"><li aria-setsize="-1" role="listitem" style="margin: 0px 0px 0px 24px; font-size: 16px; font-family: Verdana, Verdana_MSFontService, sans-serif"><p style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px;"><font color="#000000"><span lang="EN-US" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif; font-weight: bold"><span style="margin: 0px">Take a look</span><span style="margin: 0px"> </span><span style="margin: 0px">inside</span><span style="margin: 0px"> </span><span style="margin: 0px">someone</span><span style="margin: 0px"> </span><span style="margin: 0px">else’s</span><span style="margin: 0px"> </span><span style="margin: 0px">world</span><span style="margin: 0px">.</span></span><span lang="EN-US" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px"> </span><span style="margin: 0px">Spend</span><span style="margin: 0px"> a </span><span style="margin: 0px">day</span><span style="margin: 0px"> </span><span style="margin: 0px">shadowing</span><span style="margin: 0px"> </span><span style="margin: 0px">another</span><span style="margin: 0px"> team member </span><span style="margin: 0px">to</span><span style="margin: 0px"> </span><span style="margin: 0px">see</span><span style="margin: 0px"> </span><span style="margin: 0px">what</span><span style="margin: 0px"> </span><span style="margin: 0px">they</span><span style="margin: 0px"> do and </span><span style="margin: 0px">how</span><span style="margin: 0px"> </span><span style="margin: 0px">they</span><span style="margin: 0px"> </span><span style="margin: 0px">operate</span><span style="margin: 0px"> </span></span><span lang="EN-US" style="margin: 0px; font-size: 16px; font-style: italic; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif">(Wagemakers et al., 2024).</span></font></p></li></ul></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><ul role="list" style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px; font-family: verdana"><li aria-setsize="-1" role="listitem" style="margin: 0px 0px 0px 24px; font-size: 16px; font-family: Verdana, Verdana_MSFontService, sans-serif"><p style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif; font-weight: bold"><span style="margin: 0px">Meet </span><span style="margin: 0px">both</span><span style="margin: 0px"> </span><span style="margin: 0px">formally</span><span style="margin: 0px"> </span><span style="margin: 0px">and</span><span style="margin: 0px"> </span><span style="margin: 0px">informally</span><span style="margin: 0px">:</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px"> </span><span style="margin: 0px">Kick-offs</span><span style="margin: 0px">, “action </span><span style="margin: 0px">days</span><span style="margin: 0px">,” </span><span style="margin: 0px">knowledge-sharing</span><span style="margin: 0px"> </span><span style="margin: 0px">sessions</span><span style="margin: 0px">, team </span><span style="margin: 0px">activities</span><span style="margin: 0px">, </span><span style="margin: 0px">work</span><span style="margin: 0px"> meetings, </span><span style="margin: 0px">group</span><span style="margin: 0px"> chats, or even games </span><span style="margin: 0px">that</span><span style="margin: 0px"> help </span><span style="margin: 0px">you</span><span style="margin: 0px"> get </span><span style="margin: 0px">to</span><span style="margin: 0px"> </span><span style="margin: 0px">know</span><span style="margin: 0px"> </span><span style="margin: 0px">each</span><span style="margin: 0px"> </span><span style="margin: 0px">other</span><span style="margin: 0px"> in a different way.</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif">&nbsp;</span></font></p></li></ul></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><ul role="list" style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px; font-family: verdana"><li aria-setsize="-1" role="listitem" style="margin: 0px 0px 0px 24px; font-size: 16px; font-family: Verdana, Verdana_MSFontService, sans-serif"><p style="margin-right: 0px; margin-bottom: 0px; margin-left: 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif; font-weight: bold"><span style="margin: 0px">Play a </span><span style="margin: 0px">role-playing</span><span style="margin: 0px"> game.</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif"><span style="margin: 0px"> Step </span><span style="margin: 0px">into</span><span style="margin: 0px"> a </span><span style="margin: 0px">specific</span><span style="margin: 0px"> </span><span style="margin: 0px">role</span><span style="margin: 0px"> </span><span style="margin: 0px">and</span><span style="margin: 0px"> view a </span><span style="margin: 0px">situation</span><span style="margin: 0px"> </span><span style="margin: 0px">from</span><span style="margin: 0px"> </span><span style="margin: 0px">that</span><span style="margin: 0px"> </span><span style="margin: 0px">perspective</span><span style="margin: 0px">.</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif">&nbsp;</span></font></p></li></ul></div><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span><span lang="NL-NL" style="margin: 0px; font-size: 16px; font-style: italic; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px">(See, </span><span style="margin: 0px">for</span><span style="margin: 0px"> </span><span style="margin: 0px">example</span><span style="margin: 0px">, </span><span style="margin: 0px">the</span><span style="margin: 0px"> workshop </span><span style="margin: 0px">by</span><span style="margin: 0px"> Kurris et al., 2023 — link </span><span style="margin: 0px">to</span><span style="margin: 0px"> follow.)</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></font></p></div></body>
