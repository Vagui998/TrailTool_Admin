<body><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><div style="margin: 0px;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">The </span><span lang="NL-NL" style="margin: 0px; font-size: 16px; font-style: italic; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px">Practical Guide </span><span style="margin: 0px">to</span><span style="margin: 0px"> </span><span style="margin: 0px">Transdisciplinary</span><span style="margin: 0px"> </span><span style="margin: 0px">Collaboration</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px"> (Het Groene Brein, 2023) </span><span style="margin: 0px">defines</span><span style="margin: 0px"> </span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif; font-weight: bold;"><span style="margin: 0px">five </span><span style="margin: 0px">pillars</span><span style="margin: 0px"> </span><span style="margin: 0px">for</span><span style="margin: 0px"> </span><span style="margin: 0px">successful</span><span style="margin: 0px"> </span><span style="margin: 0px">collaboration</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">:</span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></font></p></div><div style="margin: 0px;"><ol role="list" start="1" style="margin-right: 0px; margin-bottom: 0px; margin-left: 0