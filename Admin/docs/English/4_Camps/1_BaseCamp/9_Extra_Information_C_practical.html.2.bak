<body><p><font color="#000000"><span lang="EN-US" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">The </span><a href="https://www.han.nl/projecten/2015/partnerschapskaart/" target="_blank" rel="noreferrer noopener" style="margin: 0px; font-family: &quot; font-size: 12px; color: inherit"><span lang="EN-US" style="margin: 0px; font-size: 16px; text-decoration-line: underline; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px">partnerschapskaart</span></span></a><span lang="EN-US" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px"> is a </span><span style="margin: 0px">dialogical</span><span style="margin: 0px"> tool </span><span style="margin: 0px">that</span><span style="margin: 0px"> </span><span style="margin: 0px">helps</span><span style="margin: 0px"> </span><span style="margin: 0px">build</span><span style="margin: 0px"> partnership </span><span style="margin: 0px">relationships</span><span style="margin: 0px"> in </span><span style="margin: 0px">transdisciplinary</span><span style="margin: 0px"> (i.e., mixed) </span><span style="margin: 0px">groups</span><span style="margin: 0px">. The </span><span style="margin: 0px">method</span><span style="margin: 0px"> </span><span style="margin: 0px">consists</span><span style="margin: 0px"> of five steps, </span><span style="margin: 0px">where</span><span style="margin: 0px"> </span><span style="margin: 0px">the</span><span style="margin: 0px"> map is </span><span style="margin: 0px">filled</span><span style="margin: 0px"> out </span><span style="margin: 0px">from</span><span style="margin: 0px"> right </span><span style="margin: 0px">to</span><span style="margin: 0px"> </span><span style="margin: 0px">left</span><span style="margin: 0px"> in a mixed </span><span style="margin: 0px">group</span><span style="margin: 0px"> of stakeholders/partners </span><span style="margin: 0px">involved</span><span style="margin: 0px"> in a project or program.</span></span><span style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;">&nbsp;</span></font></p></body>
