<body><div style="margin: 0px; font-family: &quot; font-size: 12px&quot;;"><p style="margin: 16px 0px;"><font color="#000000"><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px;">Based</span><span style="margin: 0px;"> on </span><span style="margin: 0px;">learning</span><span style="margin: 0px;"> </span><span style="margin: 0px;">objectives</span><span style="margin: 0px;"> </span><span style="margin: 0px;">and</span><span style="margin: 0px;"> </span><span style="margin: 0px;">the</span><span style="margin: 0px;"> concept of </span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; font-style: italic; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px">innovation</span><span style="margin: 0px"> </span><span style="margin: 0px">workspaces</span></span><span lang="NL-NL" style="margin: 0px; font-size: 16px; line-height: 30.225px; font-family: Verdana, Verdana_EmbeddedFont, Verdana_MSFontService, sans-serif;"><span style="margin: 0px"> (Cremers et al., 2016), </span><span style="margin: 0px">there</span><span style="margin: 0px"> are </span><span style="margin: 0px">several</span><span style="margin: 0px"> </span><span style="margin: 0px">possible</span><span style="margin: 0px"> </span><span style="margin: 0px">tangible</span><span style="margin: 0px"> </span><span style="margin: 0px">outcomes</span><span style="margin: 0px">, </span><span style="margin: 0px">such</span><span style="margin: 0px"> as </span><span style="margin: 0px">knowledge</span><span style="margin: 0px"> </span><span style="margin: 0px">acquisition</span><span style="margin: 0px"> or action-</span><span style="margin: 0px">oriented</span><span style="margin: 0px"> </span><span style="margin: 0px">results</span><span style="margin: 0px">.</span></span><span style="margin: 0px; f